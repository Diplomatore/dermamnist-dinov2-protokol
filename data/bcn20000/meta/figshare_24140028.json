om_fields": [], "figshare_url": "https://figshare.com/articles/journal_contribution/BCN20000_Dermoscopic_Lesions_in_the_Wild/24140028", "download_disabled": false, "description": "<p dir=\"ltr\">This dataset, integral to our research in AI-enhanced dermatological diagnosis, presents a unique collection of uncurated dermoscopic images. It stands out as the first of its kind to include a wide range of skin lesion images, particularly from challenging and often overlooked areas like nails and mucosa. The dataset is specifically designed to aid in the development and testing of machine-learning models, in the field of skin cancer diagnostics. Accompanied by comprehensive metadata, these images provide an resource for research in dermatology, medical imaging, and artificial intelligence, contributing to the advancement of automated and accurate skin lesion analysis.</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 9697528445, "created_date": "2024-09-19T12:35:52Z", "modified_date": "2024-09-19T12:35:53Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Dermoscopic images", "skin lesions evident", "dermatology diseases", "medical imaging report", "Machine Learning", "Artificial Intelligence", "Image Preprocessing", "Computer Vision", "Skin Cancer Diagnosis"], "keywords": ["Dermoscopic images", "skin lesions evident", "dermatology diseases", "medical imaging report", "Machine Learning", "Artificial Intelligence", "Image Preprocessing", "Computer Vision", "Skin Cancer Diagnosis"], "categories": [{"id": 24490, "title": "Dermatology", "parent_id": 24475, "path": "/24457/24475/24490", "source_id": "320205", "taxonomy_id": 100}, {"id": 28879, "title": "Computer vision", "parent_id": 28867, "path": "/28798/28867/28879", "source_id": "460304", "taxonomy_id": 10