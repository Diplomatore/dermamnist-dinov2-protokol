+def d4_yollari(kok: Path) -> dict:
+    """g0 = H10 tek görünüm train dosyası (aynı ad); g1..g7 ayrı dosyalar; val yalnız g0 (onbellek_yollari['val'])."""
+    tr = {0: kok.with_name(kok.name + "_train.npy")}
